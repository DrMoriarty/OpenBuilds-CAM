{
  "name": "openbuilds-cam",
  "productName": "OpenBuilds CAM",
  "version": "1.0.0",
  "description": "OpenBuilds CAM — browser CAM tool that converts DXF/SVG/bitmap/Gerber to G-Code, packaged as a desktop app with Electron",
  "license": "AGPL-3.0",
  "main": "electron/main.js",
  "author": "OpenBuilds",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "check": "node scripts/check-syntax.js",
    "lint": "eslint .",
    "check-html": "node scripts/check-html.js",
    "verify": "npm run check && npm run lint && npm run check-html"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.2"
  },
  "build": {
    "appId": "com.openbuilds.cam",
    "productName": "OpenBuilds CAM",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "index.html",
      "mobile.html",
      "css/**",
      "fonts/**",
      "images/**",
      "js/**",
      "lib/**",
      "workers/**",
      "workspace/**",
      "CNAME",
      "favicon.ico",
      "manifest.json",
      "site.webmanifest",
      "browserconfig.xml",
      "*.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OpenBuildsCAM-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "artifactName": "OpenBuildsCAM-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "artifactName": "OpenBuildsCAM-${version}-${arch}.${ext}"
    }
  }
}
